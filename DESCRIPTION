Type: Package
Package: Holomics
Title: OmicsHarbor - A Multi-Omics Analysis Workspace Based on Holomics
Version: 1.2.0
Authors@R: c(
    person("Paul", "Zierep", role = c("aut", "ctb"), comment = "OmicsHarbor fork development"),
